FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# Install dependencies in a separate layer so Vercel can reuse the layer cache.
COPY requirements.txt ./
RUN python -m pip install --no-compile -r requirements.txt

# Copy only files required by the deployed application. Secret files are never
# included in this image; Vercel injects them as environment variables.
COPY streamlit_app.py ./
COPY resume_analyser ./resume_analyser
COPY docs ./docs
COPY .streamlit/config.toml ./.streamlit/config.toml

EXPOSE 80

# Vercel container Functions inject PORT. Port 80 is the documented fallback.
CMD ["sh", "-c", "python -m streamlit run streamlit_app.py --server.address=0.0.0.0 --server.port=${PORT:-80} --server.headless=true --server.fileWatcherType=none --browser.gatherUsageStats=false"]
